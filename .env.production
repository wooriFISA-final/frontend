# Production Backend API URL (Nginx Reverse Proxy를 통해 접근)
# Backend는 Private 서브넷에 있으므로 Frontend Nginx가 프록시합니다
# Backend 실제 Private IP: 10.0.2.46:8000
VITE_BACKEND_URL=http://woorizip.info/api

# Production Agent API URL (Nginx Reverse Proxy를 통해 접근)
# Agent는 Private 서브넷에 있으므로 Frontend Nginx가 프록시합니다
# Agent 실제 Private IP: 예) 10.0.2.20:8080
VITE_AGENT_URL=http://woorizip.info/agent

# Environment
VITE_ENV=production

# App Information
VITE_APP_NAME=WOORI-ZIP
VITE_APP_VERSION=1.0.0
